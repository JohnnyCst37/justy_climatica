rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProfessor() {
      return isSignedIn() && (
        request.auth.token.role == 'professor' ||
        exists(/databases/$(database)/documents/professors/$(request.auth.uid))
      );
    }

    // Lista de e-mails pré-cadastrados para envio e moderação do evento
    match /authorized_emails/{email} {
      allow read, write: if isSignedIn();
    }

    // Comunidades curadas e novos territórios cadastrados pelas equipes
    match /communities/{communityId} {
      allow read: if resource.data.status == 'published' || isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isProfessor();
    }

    // Comunidades tradicionais anônimas descobertas via Google Search Grounding (escrita apenas server-side)
    match /discovered_communities/{docId} {
      allow read: if isSignedIn() || resource.data.status == 'published';
      allow write: if false;
    }

    // Trabalhos dos alunos ("Que escola está falando hoje desta comunidade?")
    match /school_works/{workId} {
      allow read: if resource.data.status == 'approved' || isSignedIn();

      allow create, update: if isSignedIn()
        && request.resource.data.status in ['pending', 'approved', 'deleted']
        && request.resource.data.schoolName is string
        && request.resource.data.communityId is string;

      allow delete: if isSignedIn();
    }

    // Blocos binários dos vídeos MP4 enviados pelas turmas
    match /school_work_chunks/{chunkId} {
      allow read: if isSignedIn() || resource.data.videoId is string;
      allow write: if isSignedIn();
    }

    // Galeria & Cobertura ao Vivo (Live) do Evento
    match /event_coverage/{itemId} {
      allow read: if isSignedIn() || resource.data.schoolName == 'EE CM João Ribeiro Vilela';
      allow create, update, delete: if isSignedIn();
    }

    // Sessões da Sala de Cinema Coletiva (coletânea de vídeos + quiz ao vivo)
    match /cinema_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Lotes dinâmicos de senhas extras geradas para docentes
    match /role_passcode_batches/{batchId} {
      allow read, write: if isSignedIn();
    }

    // Monitoramento de acessos em tempo real e tempo logado
    match /presence_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Alertas operacionais em tempo real (ex: cota e saúde da chave Gemini para Super Admin)
    match /system_alerts/{docId} {
      allow read, write: if isSignedIn();
    }

    // Perfil LGPD pseudonimizado (apenas apelido, turma e papel — sem PII obrigatória)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Estado das 3 jornadas isoladas por comunidade
      match /journeys/{communityId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Lista de professores curadores (gerenciada exclusivamente via Console / Admin SDK)
    match /professors/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Controle FinOps e reservas Anti-TOCTOU (exclusivo server-side Admin SDK)
    match /ai_quota_usage/{docId} {
      allow read, write: if false;
    }

    match /ai_quota_global/{docId} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /school_works/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)'))
          ||
          (request.resource.size < 50 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|webm|quicktime)'))
        );
    }
  }
}
